  m_Name: MEM_MertPhotoGlitch
  m_EditorClassIdentifier: NullPointer.Memory::NullPointer.Memory.MemoryData
  _stableId: memory.mert.photo_glitch
  _editorDescription: First fragmented memory glitch triggered by Mert's photograph.
  _title: BOZUK ANIMSAMA // 01
  _beats:
  - _text: "LABORATUVAR // g\xF6r\xFCnt\xFC kayb\u0131"
    _duration: 1.25
    _overlayColor: {r: 0.05, g: 0.8, b: 0.9, a: 0.38}
    _audioCue: {fileID: 0}
  - _text: "ALARM // ba\u011Flant\u0131 karars\u0131z"
    _duration: 1.25
    _overlayColor: {r: 0.85, g: 0.1, b: 0.16, a: 0.42}
    _audioCue: {fileID: 0}
  - _text: "MERT: \u201CBunu ba\u015Flat\u0131rsak geri d\xF6n\xFC\u015F\xFC yok.\u201D"
    _duration: 2
    _overlayColor: {r: 0.95, g: 0.58, b: 0.12, a: 0.35}
    _audioCue: {fileID: 0}
  - _text: "EREN // yans\u0131ma do\u011Frulanamad\u0131"
    _duration: 1.25
    _overlayColor: {r: 0.05, g: 0.65, b: 0.72, a: 0.42}
    _audioCue: {fileID: 0}
  - _text: "\u0130K\u0130 BEL\u0130RS\u0130Z F\u0130G\xDCR // kimlik \xE7\xF6z\xFClemedi"
    _duration: 1.25
    _overlayColor: {r: 0.15, g: 0.2, b: 0.25, a: 0.65}
    _audioCue: {fileID: 0}
  - _text: "S\u0130NYAL KES\u0130LD\u0130"
    _duration: 1.25
    _overlayColor: {r: 0.8, g: 0.08, b: 0.14, a: 0.48}
    _audioCue: {fileID: 0}
